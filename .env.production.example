# ============================================================
# Verdant Bistro — Template ENV PRODUKSI
# Cara pakai di server:
#   cp .env.production.example .env
#   php artisan key:generate
#   Isi APP_URL, DB_*, dan nilai lainnya sesuai server.
#   JANGAN pernah commit file .env (sudah di .gitignore).
# ============================================================

APP_NAME="Verdant Bistro"
APP_ENV=production
APP_KEY=
# WAJIB diubah: https://domain-anda.com (tanpa trailing slash)
APP_URL=https://domain-anda.com

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----- Database (MySQL) -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_db
# Ganti dengan user DB non-root + password kuat
DB_USERNAME=restaurant_user
DB_PASSWORD=ganti-dengan-password-kuat

# ----- Session -----
# 'file' cukup untuk satu server. Gunakan 'database' bila multi-server.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Hanya set true jika sudah HTTPS (jika masih HTTP, biarkan false!)
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"